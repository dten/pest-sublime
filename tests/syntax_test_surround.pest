// SYNTAX TEST "Pest.sublime-syntax"
// Official test grammar from pest-parser/pest: derive/tests/surround.pest

Quote = _{ _QuoteStart ~ QuoteChars ~ _QuoteEnd }
// <- entity.name.function.pest
//    ^ keyword.operator.pest
//      ^ keyword.operator.pest
//         ^^^^^^^^^^^ meta.function-call variable.function.pest
//                     ^ keyword.operator.pest
//                       ^^^^^^^^^^ meta.function-call variable.function.pest
//                                  ^ keyword.operator.pest
//                                    ^^^^^^^^^ meta.function-call variable.function.pest

_QuoteStart = _{
// <- entity.name.function.pest
    ( "(" ~ PUSH_LITERAL(")") )
//  ^ punctuation.section.parens.begin.pest
//    ^^^ string.quoted.double.pest
//        ^ keyword.operator.pest
//          ^^^^^^^^^^^^ meta.function-call support.function.pest
//                      ^ punctuation.section.parens.begin.pest
//                       ^^^ string.quoted.double.pest
//                          ^ punctuation.section.parens.end.pest
//                            ^ punctuation.section.parens.end.pest
    | ( "<" ~ PUSH_LITERAL(">") )
//  ^ keyword.operator.pest
//    ^ punctuation.section.parens.begin.pest
//      ^^^ string.quoted.double.pest
//          ^ keyword.operator.pest
//            ^^^^^^^^^^^^ meta.function-call support.function.pest
//                        ^ punctuation.section.parens.begin.pest
//                         ^^^ string.quoted.double.pest
//                            ^ punctuation.section.parens.end.pest
//                              ^ punctuation.section.parens.end.pest
}
_QuoteEnd = _{ POP }
// <- entity.name.function.pest
//             ^^^ meta.function-call support.function.pest

QuoteChars = { (!PEEK ~ ANY)* }
// <- entity.name.function.pest
//             ^ punctuation.section.parens.begin.pest
//              ^ keyword.operator.pest
//               ^^^^ meta.function-call support.function.pest
//                    ^ keyword.operator.pest
//                      ^^^ meta.function-call support.function.pest
//                         ^ punctuation.section.parens.end.pest
//                          ^ keyword.operator.pest
