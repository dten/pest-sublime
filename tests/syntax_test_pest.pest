// SYNTAX TEST "Pest.sublime-syntax"
// <- comment.line.double-dash.pest punctuation.definition.comment.pest
// ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.line.double-dash.pest

/* block comment */
// <- comment.block.pest punctuation.definition.comment.pest
// ^^^^^^^^^^^^^ comment.block.pest
//               ^^ comment.block.pest punctuation.definition.comment.pest

/* outer /* nested */ outer */
// <- comment.block.pest punctuation.definition.comment.pest
//       ^^ comment.block.pest punctuation.definition.comment.pest
//                 ^^ comment.block.pest punctuation.definition.comment.pest
//                          ^^ comment.block.pest punctuation.definition.comment.pest

//! Top-level grammar documentation
// <- comment.line.double-dash.pest punctuation.definition.comment.pest - invalid.pest
//^ comment.line.double-dash.pest punctuation.definition.comment.pest
//  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.line.double-dash.pest - invalid.pest

/// Rule documentation
// <- comment.line.double-dash.pest punctuation.definition.comment.pest - invalid.pest
//^ comment.line.double-dash.pest punctuation.definition.comment.pest
//  ^^^^^^^^^^^^^^^^^^ comment.line.double-dash.pest - invalid.pest

// ============================================================================
// Rule declarations & modifiers
// ============================================================================

WHITESPACE = _{ " " | "\t" }
// <- support.function.override.pest
//^^^^^^^^ support.function.override.pest
//         ^ keyword.operator.pest
//           ^ keyword.operator.pest
//            ^ - keyword.operator.pest - invalid.pest

COMMENT = @{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
// <- support.function.override.pest
//^^^^^ support.function.override.pest
//      ^ keyword.operator.pest
//        ^ keyword.operator.pest

compound_atomic = ${ SOI ~ ident ~ EOI }
// <- entity.name.function.pest
//^^^^^^^^^^^^^ entity.name.function.pest
//              ^ keyword.operator.pest
//                ^ keyword.operator.pest
//                   ^^^ meta.function-call support.function.pest
//                       ^ keyword.operator.pest
//                         ^^^^^ meta.function-call variable.function.pest
//                               ^ keyword.operator.pest
//                                 ^^^ meta.function-call support.function.pest

  indented_rule = { NEWLINE | ASCII_ALPHANUMERIC | WHITESPACE | COMMENT }
//^^^^^^^^^^^^^ entity.name.function.pest
//              ^ keyword.operator.pest
//                  ^^^^^^^ meta.function-call support.function.pest
//                          ^ keyword.operator.pest
//                            ^^^^^^^^^^^^^^^^^^ meta.function-call support.function.pest
//                                               ^ keyword.operator.pest
//                                                 ^^^^^^^^^^ meta.function-call support.function.pest
//                                                            ^ keyword.operator.pest
//                                                              ^^^^^^^ meta.function-call support.function.pest

push_pop = { PUSH(ident) ~ PUSH_LITERAL("a") ~ PEEK ~ PEEK_ALL ~ POP ~ POP_ALL ~ DROP }
//           ^^^^ meta.function-call support.function.pest
//               ^ punctuation.section.parens.begin.pest
//                ^^^^^ meta.function-call variable.function.pest
//                     ^ punctuation.section.parens.end.pest
//                       ^ keyword.operator.pest
//                         ^^^^^^^^^^^^ meta.function-call support.function.pest
//                                     ^ punctuation.section.parens.begin.pest
//                                      ^^^ string.quoted.double.pest
//                                         ^ punctuation.section.parens.end.pest
//                                           ^ keyword.operator.pest
//                                             ^^^^ meta.function-call support.function.pest
//                                                  ^ keyword.operator.pest
//                                                    ^^^^^^^^ meta.function-call support.function.pest
//                                                             ^ keyword.operator.pest
//                                                               ^^^ meta.function-call support.function.pest
//                                                                   ^ keyword.operator.pest
//                                                                     ^^^^^^^ meta.function-call support.function.pest
//                                                                             ^ keyword.operator.pest
//                                                                               ^^^^ meta.function-call support.function.pest

multiline_rule = {
// <- entity.name.function.pest
    // inline comment inside rule
//  ^^ comment.line.double-dash.pest punctuation.definition.comment.pest
    /* block comment inside rule */
//  ^^ comment.block.pest punctuation.definition.comment.pest
    "first"
//  ^^^^^^^ string.quoted.double.pest
  | "second"
//^ keyword.operator.pest
//  ^^^^^^^^ string.quoted.double.pest
}

// ============================================================================
// Strings, characters, ranges & escapes
// ============================================================================

strings = { "hello" ~ ^"case_insensitive" }
//          ^ string.quoted.double.pest punctuation.definition.string.begin.pest
//           ^^^^^ string.quoted.double.pest
//                ^ string.quoted.double.pest punctuation.definition.string.end.pest
//                  ^ keyword.operator.pest
//                    ^ keyword.operator.pest
//                     ^ string.quoted.double.pest punctuation.definition.string.begin.pest
//                      ^^^^^^^^^^^^^^^^ string.quoted.double.pest
//                                      ^ string.quoted.double.pest punctuation.definition.string.end.pest

chars_and_ranges = { 'a' ~ '0'..'9' ~ '\x00'..'\x7f' }
//                   ^ string.quoted.single.pest punctuation.definition.string.begin.pest
//                    ^ string.quoted.single.pest
//                     ^ string.quoted.single.pest punctuation.definition.string.end.pest
//                       ^ keyword.operator.pest
//                         ^ string.quoted.single.pest punctuation.definition.string.begin.pest
//                          ^ string.quoted.single.pest
//                           ^ string.quoted.single.pest punctuation.definition.string.end.pest
//                            ^^ keyword.operator.range.pest
//                              ^ string.quoted.single.pest punctuation.definition.string.begin.pest
//                               ^ string.quoted.single.pest
//                                ^ string.quoted.single.pest punctuation.definition.string.end.pest
//                                  ^ keyword.operator.pest
//                                    ^^^^^^ string.quoted.single.pest
//                                     ^^^^ constant.character.escape.pest
//                                          ^^ keyword.operator.range.pest
//                                            ^^^^^^ string.quoted.single.pest
//                                             ^^^^ constant.character.escape.pest

escapes = { "\"\\\r\n\t\0\'\x41\u{1f}\u{10FFFF}" ~ '\'' }
//          ^ string.quoted.double.pest punctuation.definition.string.begin.pest
//           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double.pest constant.character.escape.pest
//                                             ^ string.quoted.double.pest punctuation.definition.string.end.pest
//                                               ^ keyword.operator.pest
//                                                 ^ string.quoted.single.pest punctuation.definition.string.begin.pest
//                                                  ^^ string.quoted.single.pest constant.character.escape.pest
//                                                    ^ string.quoted.single.pest punctuation.definition.string.end.pest

invalid_escapes = { "\q \x1 \u{1} \u{1234567}" ~ '\q' }
//                   ^^ string.quoted.double.pest invalid.pest
//                      ^^ string.quoted.double.pest invalid.pest
//                          ^^ string.quoted.double.pest invalid.pest
//                                ^^ string.quoted.double.pest invalid.pest
//                                                ^^ string.quoted.single.pest invalid.pest

// ============================================================================
// Operators, predicates & grouping
// ============================================================================

operators = { !a ~ &b | (c ~ (d | e)) }
//            ^ keyword.operator.pest
//             ^ meta.function-call variable.function.pest
//               ^ keyword.operator.pest
//                 ^ keyword.operator.pest
//                  ^ meta.function-call variable.function.pest
//                    ^ keyword.operator.pest
//                      ^ punctuation.section.parens.begin.pest
//                       ^ meta.function-call variable.function.pest
//                         ^ keyword.operator.pest
//                           ^ punctuation.section.parens.begin.pest
//                            ^ meta.function-call variable.function.pest
//                              ^ keyword.operator.pest
//                                ^ meta.function-call variable.function.pest
//                                 ^^ punctuation.section.parens.end.pest

trailing_ops = { a* ~ b+ ~ c? ~ "s"* ~ 'c'? ~ 'a'..'z'+ ~ (x | y)+ ~ ANY* }
//               ^ meta.function-call variable.function.pest
//                ^ keyword.operator.pest
//                  ^ keyword.operator.pest
//                    ^ meta.function-call variable.function.pest
//                     ^ keyword.operator.pest
//                       ^ keyword.operator.pest
//                         ^ meta.function-call variable.function.pest
//                          ^ keyword.operator.pest
//                            ^ keyword.operator.pest
//                              ^^^ string.quoted.double.pest
//                                 ^ keyword.operator.pest
//                                   ^ keyword.operator.pest
//                                     ^^^ string.quoted.single.pest
//                                        ^ keyword.operator.pest
//                                          ^ keyword.operator.pest
//                                            ^^^ string.quoted.single.pest
//                                               ^^ keyword.operator.range.pest
//                                                 ^^^ string.quoted.single.pest
//                                                    ^ keyword.operator.pest
//                                                      ^ keyword.operator.pest
//                                                        ^ punctuation.section.parens.begin.pest
//                                                             ^ meta.function-call variable.function.pest
//                                                              ^ punctuation.section.parens.end.pest
//                                                               ^ keyword.operator.pest
//                                                                 ^ keyword.operator.pest
//                                                                   ^^^ meta.function-call support.function.pest
//                                                                      ^ keyword.operator.pest

// ============================================================================
// Braced repetitions
// ============================================================================

a = { x{2} }
// <- entity.name.function.pest
//^ keyword.operator.pest
//    ^ meta.function-call variable.function.pest
//     ^^^ - invalid.pest
//      ^ constant.numeric.integer.pest
//         ^ - invalid.pest

b = { x{2,3} }
// <- entity.name.function.pest
//^ keyword.operator.pest
//    ^ meta.function-call variable.function.pest
//     ^^^^^ - invalid.pest
//      ^ constant.numeric.integer.pest
//        ^ constant.numeric.integer.pest
//           ^ - invalid.pest

c = { x{2,} }
// <- entity.name.function.pest
//^ keyword.operator.pest
//    ^ meta.function-call variable.function.pest
//     ^^^^ - invalid.pest
//      ^ constant.numeric.integer.pest
//          ^ - invalid.pest

d = { x{,3} }
// <- entity.name.function.pest
//^ keyword.operator.pest
//    ^ meta.function-call variable.function.pest
//     ^^^^ - invalid.pest
//       ^ constant.numeric.integer.pest
//          ^ - invalid.pest

e = { "x"{2,} ~ b{,3} ~ 'a'{4} ~ '0'..'9'{1,2} ~ (x | y){3,5} ~ ANY{2} }
// <- entity.name.function.pest
//^ keyword.operator.pest
//    ^^^ string.quoted.double.pest
//       ^^^^ - invalid.pest
//        ^ constant.numeric.integer.pest
//            ^ keyword.operator.pest - invalid.pest
//              ^ meta.function-call variable.function.pest
//               ^^^^ - invalid.pest
//                 ^ constant.numeric.integer.pest
//                    ^ keyword.operator.pest - invalid.pest
//                      ^^^ string.quoted.single.pest
//                         ^^^ - invalid.pest
//                          ^ constant.numeric.integer.pest
//                             ^ keyword.operator.pest - invalid.pest
//                               ^^^ string.quoted.single.pest
//                                  ^^ keyword.operator.range.pest
//                                    ^^^ string.quoted.single.pest
//                                       ^^^^^ - invalid.pest
//                                        ^ constant.numeric.integer.pest
//                                          ^ constant.numeric.integer.pest
//                                             ^ keyword.operator.pest - invalid.pest
//                                               ^ punctuation.section.parens.begin.pest
//                                                     ^ punctuation.section.parens.end.pest
//                                                      ^^^^^ - invalid.pest
//                                                       ^ constant.numeric.integer.pest
//                                                         ^ constant.numeric.integer.pest
//                                                            ^ keyword.operator.pest - invalid.pest
//                                                              ^^^ meta.function-call support.function.pest
//                                                                 ^^^ - invalid.pest
//                                                                  ^ constant.numeric.integer.pest
//                                                                     ^ - invalid.pest

f = { x{2, 3} ~ y{2, } ~ z{, 3} }
//     ^^^^^^ - invalid.pest
//      ^ constant.numeric.integer.pest
//         ^ constant.numeric.integer.pest
//            ^ keyword.operator.pest
//               ^^^^^ - invalid.pest
//                ^ constant.numeric.integer.pest
//                     ^ keyword.operator.pest
//                        ^^^^^ - invalid.pest
//                           ^ constant.numeric.integer.pest
//                              ^ - invalid.pest

// ============================================================================
// Invalid syntax & recovery
// ============================================================================

invalid_double_trailing = { x** ~ y+? ~ "a"*+ }
//                           ^ keyword.operator.pest
//                            ^ invalid.pest
//                              ^ keyword.operator.pest
//                                 ^ keyword.operator.pest
//                                  ^ invalid.pest
//                                    ^ keyword.operator.pest
//                                         ^ keyword.operator.pest
//                                          ^ invalid.pest

invalid_range = { 'a'..b }
//                ^^^ string.quoted.single.pest
//                   ^^ keyword.operator.range.pest
//                     ^ invalid.pest
//                       ^ - invalid.pest

invalid_empty = { x{} }
//                 ^ - invalid.pest
//                  ^ invalid.pest
//                    ^ - invalid.pest

invalid_comma = { x{,} }
//                 ^^ - invalid.pest
//                   ^ invalid.pest
//                     ^ - invalid.pest

invalid_brace_unclosed_digit = { x{a} ~ x{,a} }
//                                 ^^ invalid.pest
//                                    ^ keyword.operator.pest - invalid.pest
//                                         ^^ invalid.pest
//                                            ^ - invalid.pest

invalid_brace_stages = { x{a 2} ~ x{,a 3} ~ x{,3a} ~ x{2a} ~ x{2,a} ~ x{2,3a} ~ x{2,3,4} }
//                         ^ invalid.pest
//                           ^ constant.numeric.integer.pest
//                            ^ - invalid.pest
//                                   ^ invalid.pest
//                                     ^ constant.numeric.integer.pest
//                                      ^ - invalid.pest
//                                             ^ constant.numeric.integer.pest
//                                              ^ invalid.pest
//                                               ^ - invalid.pest
//                                                     ^ constant.numeric.integer.pest
//                                                      ^ invalid.pest
//                                                       ^ - invalid.pest
//                                                             ^ constant.numeric.integer.pest
//                                                               ^ invalid.pest
//                                                                ^ - invalid.pest
//                                                                      ^ constant.numeric.integer.pest
//                                                                        ^ constant.numeric.integer.pest
//                                                                         ^ invalid.pest
//                                                                          ^ - invalid.pest
//                                                                                ^ constant.numeric.integer.pest
//                                                                                  ^ constant.numeric.integer.pest
//                                                                                   ^^ invalid.pest
//                                                                                     ^ - invalid.pest

invalid_before_equals : = { "ok" }
// <- entity.name.function.pest
//                    ^ invalid.pest
//                      ^ keyword.operator.pest
//                          ^^^^ string.quoted.double.pest

invalid_rule_body_token = { a ~ # ~ b }
//                          ^ meta.function-call variable.function.pest
//                            ^ keyword.operator.pest
//                              ^ invalid.pest
//                                ^ keyword.operator.pest
//                                  ^ meta.function-call variable.function.pest

// ============================================================================
// Edge cases: whitespace, inline comments, multi-rule lines, PEEK slices, numbers
// ============================================================================

/* inline comment */ rule_one = { "a" } rule_two = _{ "b" } WHITESPACE = _{ " " }
//                   ^^^^^^^^ entity.name.function.pest - invalid.pest
//                            ^ keyword.operator.pest
//                                ^^^ string.quoted.double.pest
//                                      ^^^^^^^^ entity.name.function.pest - invalid.pest
//                                               ^ keyword.operator.pest
//                                                 ^ keyword.operator.pest
//                                                    ^^^ string.quoted.double.pest
//                                                          ^^^^^^^^^^ support.function.override.pest - invalid.pest

commented_decl /* c1 */ = /* c2 */ @ /* c3 */ {
// <- entity.name.function.pest
//             ^^^^^^^^ comment.block.pest
//                      ^ keyword.operator.pest
//                        ^^^^^^^^ comment.block.pest
//                                 ^ keyword.operator.pest
//                                   ^^^^^^^^ comment.block.pest
    ^ "spaced_insensitive" ~ 'a' /* c4 */ .. /* c5 */ 'z' + ~ x { 2 /* c6 */ , /* c7 */ 3 }
//  ^ keyword.operator.pest - invalid.pest
//    ^^^^^^^^^^^^^^^^^^^^ string.quoted.double.pest
//                         ^ keyword.operator.pest
//                           ^^^ string.quoted.single.pest
//                               ^^^^^^^^ comment.block.pest
//                                        ^^ keyword.operator.range.pest
//                                           ^^^^^^^^ comment.block.pest
//                                                    ^^^ string.quoted.single.pest
//                                                        ^ keyword.operator.pest - invalid.pest
//                                                          ^ keyword.operator.pest
//                                                            ^ meta.function-call variable.function.pest
//                                                                ^ constant.numeric.integer.pest
//                                                                  ^^^^^^^^ comment.block.pest
//                                                                           ^ - invalid.pest
//                                                                             ^^^^^^^^ comment.block.pest
//                                                                                      ^ constant.numeric.integer.pest
}

peek_slices = { PEEK[..] ~ PEEK[0..] ~ PEEK[..-1] ~ PEEK[1..-2]* }
//              ^^^^ meta.function-call support.function.pest
//                  ^^^^ - invalid.pest
//                   ^^ keyword.operator.range.pest
//                         ^^^^ meta.function-call support.function.pest
//                              ^ constant.numeric.integer.pest
//                               ^^ keyword.operator.range.pest
//                                     ^^^^ meta.function-call support.function.pest
//                                          ^^ keyword.operator.range.pest
//                                            ^^ constant.numeric.integer.pest
//                                                  ^^^^ meta.function-call support.function.pest
//                                                       ^ constant.numeric.integer.pest
//                                                        ^^ keyword.operator.range.pest
//                                                          ^^ constant.numeric.integer.pest
//                                                             ^ keyword.operator.pest

invalid_peek_slices = { PEEK[foo] ~ PEEK[1] ~ PEEK[-0] ~ PEEK[1..2..3] }
//                      ^^^^ meta.function-call support.function.pest
//                           ^^^ invalid.pest
//                              ^ - invalid.pest
//                                ^ keyword.operator.pest
//                                  ^^^^ meta.function-call support.function.pest
//                                       ^ constant.numeric.integer.pest
//                                        ^ invalid.pest
//                                          ^ keyword.operator.pest
//                                            ^^^^ meta.function-call support.function.pest
//                                                 ^^ invalid.pest
//                                                   ^ - invalid.pest
//                                                     ^ keyword.operator.pest
//                                                       ^^^^ meta.function-call support.function.pest
//                                                            ^ constant.numeric.integer.pest
//                                                             ^^ keyword.operator.range.pest
//                                                               ^ constant.numeric.integer.pest
//                                                                ^^^ invalid.pest
//                                                                   ^ - invalid.pest

invalid_bare_numbers = { 123 ~ 456 }
//                       ^^^ invalid.pest - variable.function.pest
//                           ^ keyword.operator.pest
//                             ^^^ invalid.pest - variable.function.pest

invalid_trailing_backslash = { "hello\
//                                   ^ string.quoted.double.pest invalid.pest
world" }
//^^^ string.quoted.double.pest

// ============================================================================
// Real-world Pest grammar constructs (from pest meta/src/grammar.pest)
// ============================================================================

grammar_rule = {
    identifier ~ assignment_operator ~ modifier? ~ opening_brace ~ expression ~ closing_brace
//  ^^^^^^^^^^ meta.function-call variable.function.pest
//             ^ keyword.operator.pest
//               ^^^^^^^^^^^^^^^^^^^ meta.function-call variable.function.pest
//                                   ^ keyword.operator.pest
//                                     ^^^^^^^^ meta.function-call variable.function.pest
//                                             ^ keyword.operator.pest
//                                               ^ keyword.operator.pest
//                                                 ^^^^^^^^^^^^^ meta.function-call variable.function.pest
//                                                               ^ keyword.operator.pest
//                                                                 ^^^^^^^^^^ meta.function-call variable.function.pest
//                                                                            ^ keyword.operator.pest
//                                                                              ^^^^^^^^^^^^^ meta.function-call variable.function.pest
  | line_doc
//^ keyword.operator.pest
//  ^^^^^^^^ meta.function-call variable.function.pest
}

modifier = _{
//         ^ keyword.operator.pest
    silent_modifier
  | atomic_modifier
  | compound_atomic_modifier
  | non_atomic_modifier
}

silent_modifier          = { "_" }
atomic_modifier          = { "@" }
compound_atomic_modifier = { "$" }
non_atomic_modifier      = { "!" }

expression =  { term ~ (infix_operator ~ term)* }
//              ^^^^ meta.function-call variable.function.pest
//                   ^ keyword.operator.pest
//                     ^ punctuation.section.parens.begin.pest
//                      ^^^^^^^^^^^^^^ meta.function-call variable.function.pest
//                                     ^ keyword.operator.pest
//                                       ^^^^ meta.function-call variable.function.pest
//                                           ^ punctuation.section.parens.end.pest
//                                            ^ keyword.operator.pest

term       =  { prefix_operator* ~ node ~ postfix_operator* }
//              ^^^^^^^^^^^^^^^ meta.function-call variable.function.pest
//                             ^ keyword.operator.pest
//                               ^ keyword.operator.pest
//                                 ^^^^ meta.function-call variable.function.pest
//                                      ^ keyword.operator.pest
//                                        ^^^^^^^^^^^^^^^^ meta.function-call variable.function.pest
//                                                        ^ keyword.operator.pest

node       = _{ opening_paren ~ expression ~ closing_paren | terminal }
terminal   = _{ _push | peek_slice | identifier | string | insensitive_string | range }

_push      =  { "PUSH" ~ opening_paren ~ expression ~ closing_paren }
peek_slice =  { "PEEK" ~ opening_brack ~ integer? ~ range_operator ~ integer? ~ closing_brack }

integer = @{ number | "-" ~ "0"* ~ '1'..'9' ~ number? }
//        ^ keyword.operator.pest
//           ^^^^^^ meta.function-call variable.function.pest
//                  ^ keyword.operator.pest
//                    ^^^ string.quoted.double.pest
//                        ^ keyword.operator.pest
//                          ^^^ string.quoted.double.pest
//                             ^ keyword.operator.pest
//                               ^ keyword.operator.pest
//                                 ^^^ string.quoted.single.pest
//                                    ^^ keyword.operator.range.pest
//                                      ^^^ string.quoted.single.pest
//                                          ^ keyword.operator.pest
//                                            ^^^^^^ meta.function-call variable.function.pest
//                                                  ^ keyword.operator.pest

unicode   = @{ "u" ~ opening_brace ~ hex_digit{2, 6} ~ closing_brace }
//          ^ keyword.operator.pest
//             ^^^ string.quoted.double.pest
//                 ^ keyword.operator.pest
//                   ^^^^^^^^^^^^^ meta.function-call variable.function.pest
//                                 ^ keyword.operator.pest
//                                   ^^^^^^^^^ meta.function-call variable.function.pest
//                                            ^^^^^^ - invalid.pest
//                                             ^ constant.numeric.integer.pest
//                                                ^ constant.numeric.integer.pest
//                                                   ^ keyword.operator.pest
//                                                     ^^^^^^^^^^^^^ meta.function-call variable.function.pest

hex_digit = @{ '0'..'9' | 'a'..'f' | 'A'..'F' }
//          ^ keyword.operator.pest
//             ^^^ string.quoted.single.pest
//                ^^ keyword.operator.range.pest
//                  ^^^ string.quoted.single.pest
//                      ^ keyword.operator.pest
//                        ^^^ string.quoted.single.pest
//                           ^^ keyword.operator.range.pest
//                             ^^^ string.quoted.single.pest
//                                 ^ keyword.operator.pest
//                                   ^^^ string.quoted.single.pest
//                                      ^^ keyword.operator.range.pest
//                                        ^^^ string.quoted.single.pest

// ============================================================================
// Parser & validator edge cases (from pest meta/src/parser.rs & validator.rs)
// ============================================================================

_ = { "a" }
// <- invalid.pest
//^ keyword.operator.pest
//    ^^^ string.quoted.double.pest
ANY = { "a" }
// <- invalid.pest
//^ invalid.pest
//  ^ keyword.operator.pest
SOI = { "a" }
// <- invalid.pest
PUSH = { "a" }
// <- invalid.pest
SYMBOL = { "shadows builtin unicode category" }
// <- entity.name.function.pest - invalid.pest
bare_underscore_in_expr = { _ ~ _ok }
//                          ^ invalid.pest
//                            ^ keyword.operator.pest
//                              ^^^ meta.function-call variable.function.pest - invalid.pest

unclosed_paren = { (a }
//                 ^ punctuation.section.parens.begin.pest
//                  ^ meta.function-call variable.function.pest
//                    ^ invalid.pest
after_unclosed_paren = { "recovered" }
// <- entity.name.function.pest - invalid.pest
//                   ^ keyword.operator.pest
//                       ^^^^^^^^^^^ string.quoted.double.pest

invalid_chars = { '' ~ 'abc' ~ 'a'..'cd' }
//                ^ punctuation.definition.string.begin.pest
//                 ^ invalid.pest
//                   ^ keyword.operator.pest
//                     ^ punctuation.definition.string.begin.pest
//                      ^ string.quoted.single.pest - invalid.pest
//                       ^^ string.quoted.single.pest invalid.pest
//                         ^ punctuation.definition.string.end.pest
//                           ^ keyword.operator.pest
//                             ^^^ string.quoted.single.pest - invalid.pest
//                                ^^ keyword.operator.range.pest
//                                  ^ punctuation.definition.string.begin.pest
//                                   ^ string.quoted.single.pest - invalid.pest
//                                    ^ string.quoted.single.pest invalid.pest
//                                     ^ punctuation.definition.string.end.pest
unclosed_char_eol = { 'a
//                    ^ punctuation.definition.string.begin.pest
//                     ^ invalid.pest
}
after_unclosed_char = { "ok" }
// <- entity.name.function.pest - invalid.pest

empty_rule = {}
// <- entity.name.function.pest
//            ^ invalid.pest
empty_parens = { () ~ a }
//               ^ punctuation.section.parens.begin.pest
//                ^ invalid.pest
//                  ^ keyword.operator.pest
//                    ^ meta.function-call variable.function.pest

leading_seq = { ~ a }
//              ^ invalid.pest
//                ^ meta.function-call variable.function.pest
trailing_seq = { a ~ }
//               ^ meta.function-call variable.function.pest
//                 ^ keyword.operator.pest
//                   ^ invalid.pest
trailing_choice = { a | }
//                  ^ meta.function-call variable.function.pest
//                    ^ keyword.operator.pest
//                      ^ invalid.pest
trailing_pred = { ! }
//                ^ keyword.operator.pest
//                  ^ invalid.pest
trailing_tag = { #t = }
//               ^^ entity.name.tag.pest
//                  ^ keyword.operator.pest
//                    ^ invalid.pest
trailing_in_paren = { (a ~) }
//                     ^ meta.function-call variable.function.pest
//                       ^ keyword.operator.pest
//                        ^ invalid.pest
consecutive_ops = { a ~ ~ b | ~ c ~ ! ~ d }
//                  ^ meta.function-call variable.function.pest
//                    ^ keyword.operator.pest
//                      ^ invalid.pest
//                        ^ meta.function-call variable.function.pest
//                          ^ keyword.operator.pest
//                            ^ invalid.pest
//                              ^ meta.function-call variable.function.pest
//                                ^ keyword.operator.pest
//                                  ^ keyword.operator.pest
//                                    ^ invalid.pest
//                                      ^ meta.function-call variable.function.pest

missing_infix = { a b ~ "x" "y" ~ c& }
//                ^ meta.function-call variable.function.pest
//                  ^ invalid.pest
//                    ^ keyword.operator.pest
//                      ^^^ string.quoted.double.pest
//                          ^^^ invalid.pest
//                              ^ keyword.operator.pest
//                                ^ meta.function-call variable.function.pest
//                                 ^ invalid.pest

valid_push_spaced = { PUSH ( a ) ~ PUSH_LITERAL ( "x" ) }
//                    ^^^^ meta.function-call support.function.pest - invalid.pest
//                         ^ punctuation.section.parens.begin.pest
//                           ^ meta.function-call variable.function.pest
//                             ^ punctuation.section.parens.end.pest
//                               ^ keyword.operator.pest
//                                 ^^^^^^^^^^^^ meta.function-call support.function.pest - invalid.pest
//                                              ^ punctuation.section.parens.begin.pest
//                                                ^^^ string.quoted.double.pest
//                                                    ^ punctuation.section.parens.end.pest
invalid_push_calls = { PUSH ~ PUSH() ~ PUSH_LITERAL ~ PUSH_LITERAL() ~ PUSH_LITERAL(ident) }
//                     ^^^^ invalid.pest
//                          ^ keyword.operator.pest
//                            ^^^^ meta.function-call support.function.pest
//                                ^ punctuation.section.parens.begin.pest
//                                 ^ invalid.pest
//                                   ^ keyword.operator.pest
//                                     ^^^^^^^^^^^^ invalid.pest
//                                                  ^ keyword.operator.pest
//                                                    ^^^^^^^^^^^^ meta.function-call support.function.pest
//                                                                ^ punctuation.section.parens.begin.pest
//                                                                 ^ invalid.pest
//                                                                   ^ keyword.operator.pest
//                                                                     ^^^^^^^^^^^^ meta.function-call support.function.pest
//                                                                                 ^ punctuation.section.parens.begin.pest
//                                                                                  ^^^^^ invalid.pest
//                                                                                       ^ punctuation.section.parens.end.pest

chained_postfix = { x{2}? ~ y+{2} ~ z{2}{3} }
//                  ^ meta.function-call variable.function.pest
//                   ^^^ - invalid.pest
//                    ^ constant.numeric.integer.pest
//                      ^ keyword.operator.pest - invalid.pest
//                        ^ keyword.operator.pest
//                          ^ meta.function-call variable.function.pest
//                           ^ keyword.operator.pest - invalid.pest
//                            ^^^ - invalid.pest
//                             ^ constant.numeric.integer.pest
//                                ^ keyword.operator.pest
//                                  ^ meta.function-call variable.function.pest
//                                   ^^^^^^ - invalid.pest
//                                    ^ constant.numeric.integer.pest
//                                       ^ constant.numeric.integer.pest

// ============================================================================
// Real-world constructs & additional pest_meta edge cases
// ============================================================================

/// Rule doc before real_world_constructs
// <- comment.line.double-dash.pest punctuation.definition.comment.pest - invalid.pest
//^ comment.line.double-dash.pest punctuation.definition.comment.pest
real_world_constructs = {
    PUSH(" "+) ~ PEEK[-2..-1] ~ PUSH("  " ~ POP) ~ PUSH("'" | "\"") ~ ('0' .. '9')+
//  ^^^^ meta.function-call support.function.pest - invalid.pest
//       ^^^ string.quoted.double.pest
//          ^ keyword.operator.pest
//               ^^^^ meta.function-call support.function.pest
//                    ^^ constant.numeric.integer.pest
//                      ^^ keyword.operator.range.pest
//                        ^^ constant.numeric.integer.pest
//                              ^^^^ meta.function-call support.function.pest
//                                   ^^^^ string.quoted.double.pest
//                                        ^ keyword.operator.pest
//                                          ^^^ meta.function-call support.function.pest
//                                                 ^^^^ meta.function-call support.function.pest
//                                                      ^^^ string.quoted.double.pest
//                                                          ^ keyword.operator.pest
//                                                            ^^^^ string.quoted.double.pest
//                                                                     ^^^ string.quoted.single.pest
//                                                                         ^^ keyword.operator.range.pest
//                                                                            ^^^ string.quoted.single.pest
//                                                                                ^ keyword.operator.pest
  ~ PUSH_LITERAL("]") ~ #_ = a ~ #tag = !"x" ~ #page=b
//  ^^^^^^^^^^^^ meta.function-call support.function.pest
//               ^^^ string.quoted.double.pest
//                      ^^ entity.name.tag.pest - invalid.pest
//                         ^ keyword.operator.pest
//                           ^ meta.function-call variable.function.pest
//                               ^^^^ entity.name.tag.pest - invalid.pest
//                                    ^ keyword.operator.pest
//                                      ^ keyword.operator.pest
//                                       ^^^ string.quoted.double.pest
//                                             ^^^^^ entity.name.tag.pest - invalid.pest
//                                                  ^ keyword.operator.pest
//                                                   ^ meta.function-call variable.function.pest
  ~ ^ /* c1 */ "abc" ~ #spaced_tag /* c2 */ = a ~ PEEK /* c3 */ [..]
//  ^ keyword.operator.pest - invalid.pest
//    ^^^^^^^^ comment.block.pest
//             ^^^^^ string.quoted.double.pest - invalid.pest
//                     ^^^^^^^^^^^ entity.name.tag.pest - invalid.pest
//                                 ^^^^^^^^ comment.block.pest
//                                          ^ keyword.operator.pest - invalid.pest
//                                            ^ meta.function-call variable.function.pest
//                                                ^^^^ meta.function-call support.function.pest
//                                                     ^^^^^^^^ comment.block.pest
//                                                              ^^^^ - invalid.pest
//                                                               ^^ keyword.operator.range.pest
  ~ PUSH /* c4 */ ("a") ~ PUSH_LITERAL /* c5 */ ("a")
//  ^^^^ meta.function-call support.function.pest - invalid.pest
//       ^^^^^^^^ comment.block.pest
//                ^ punctuation.section.parens.begin.pest
//                 ^^^ string.quoted.double.pest
//                    ^ punctuation.section.parens.end.pest
//                        ^^^^^^^^^^^^ meta.function-call support.function.pest - invalid.pest
//                                     ^^^^^^^^ comment.block.pest
//                                              ^ punctuation.section.parens.begin.pest
//                                               ^^^ string.quoted.double.pest
//                                                  ^ punctuation.section.parens.end.pest
}

invalid_paren_leading_choice = { (| "a" | "b") }
//                               ^ punctuation.section.parens.begin.pest
//                                ^ invalid.pest
//                                  ^^^ string.quoted.double.pest
//                                      ^ keyword.operator.pest
//                                        ^^^ string.quoted.double.pest
//                                           ^ punctuation.section.parens.end.pest

invalid_tags = { ! #tag = "x" ~ #t1 = #t2 = "y" ~ # spaced = "z" }
//               ^ keyword.operator.pest
//                 ^^^^^^ invalid.pest
//                        ^^^ string.quoted.double.pest
//                            ^ keyword.operator.pest
//                              ^^^ entity.name.tag.pest - invalid.pest
//                                  ^ keyword.operator.pest
//                                    ^^^^^ invalid.pest
//                                          ^^^ string.quoted.double.pest
//                                              ^ keyword.operator.pest
//                                                ^ invalid.pest
//                                                  ^^^^^^ invalid.pest

invalid_caret = { ^ident ~ ^'a' }
//                ^ keyword.operator.pest
//                 ^^^^^ invalid.pest
//                       ^ keyword.operator.pest
//                         ^ keyword.operator.pest
//                          ^^^ invalid.pest

//! Grammar doc after rules is invalid
// <- invalid.pest
//^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ invalid.pest

invalid_doc_in_rule = {
    /// outer doc inside rule body is invalid
//  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ invalid.pest
    //! inner doc inside rule body is invalid
//  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ invalid.pest
    /////////////////////////////////////////
//  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ invalid.pest
    "still_parses"
//  ^^^^^^^^^^^^^^ string.quoted.double.pest - invalid.pest
}


