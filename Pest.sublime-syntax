%YAML 1.2
---
# http://www.sublimetext.com/docs/3/syntax.html
name: Pest
file_extensions:
  - pest
scope: source.pest.pest
variables:
  ident: '\b(?!(?:PUSH|PUSH_LITERAL)\b)(?:_\w+|[a-zA-Z]\w*)\b'
  trailing_op: '[*?+]'
  replaceable_support_idents: '\b(WHITESPACE|COMMENT)\b'
  forbidden_rule_idents: '\b(_|ANY|DROP|EOI|PEEK_ALL|PEEK|POP_ALL|POP|PUSH_LITERAL|PUSH|SOI)\b'
  builtin_rules: '\b(ANY|DROP|EOI|NEWLINE|PEEK_ALL|PEEK|POP_ALL|POP|SOI)\b'
  ascii_rules: '\b(ASCII_ALPHANUMERIC|ASCII_ALPHA_LOWER|ASCII_ALPHA_UPPER|ASCII_ALPHA|ASCII_BIN_DIGIT|ASCII_DIGIT|ASCII_HEX_DIGIT|ASCII_NONZERO_DIGIT|ASCII_OCT_DIGIT|ASCII)\b'
  unicode_binary_rules: '\b(ALPHABETIC|BIDI_CONTROL|CASE_IGNORABLE|CASED|CHANGES_WHEN_CASEFOLDED|CHANGES_WHEN_CASEMAPPED|CHANGES_WHEN_LOWERCASED|CHANGES_WHEN_TITLECASED|CHANGES_WHEN_UPPERCASED|DASH|DEFAULT_IGNORABLE_CODE_POINT|DEPRECATED|DIACRITIC|EMOJI_COMPONENT|EMOJI_MODIFIER_BASE|EMOJI_MODIFIER|EMOJI_PRESENTATION|EMOJI|EXTENDED_PICTOGRAPHIC|EXTENDER|GRAPHEME_BASE|GRAPHEME_EXTEND|GRAPHEME_LINK|HEX_DIGIT|HYPHEN|IDS_BINARY_OPERATOR|IDS_TRINARY_OPERATOR|ID_CONTINUE|ID_START|IDEOGRAPHIC|JOIN_CONTROL|LOGICAL_ORDER_EXCEPTION|LOWERCASE|MATH|NONCHARACTER_CODE_POINT|OTHER_ALPHABETIC|OTHER_DEFAULT_IGNORABLE_CODE_POINT|OTHER_GRAPHEME_EXTEND|OTHER_ID_CONTINUE|OTHER_ID_START|OTHER_LOWERCASE|OTHER_MATH|OTHER_UPPERCASE|PATTERN_SYNTAX|PATTERN_WHITE_SPACE|PREPENDED_CONCATENATION_MARK|QUOTATION_MARK|RADICAL|REGIONAL_INDICATOR|SENTENCE_TERMINAL|SOFT_DOTTED|TERMINAL_PUNCTUATION|UNIFIED_IDEOGRAPH|UPPERCASE|VARIATION_SELECTOR|WHITE_SPACE|XID_CONTINUE|XID_START)\b'
  unicode_category_rules: '\b(CASED_LETTER|CLOSE_PUNCTUATION|CONNECTOR_PUNCTUATION|CONTROL|CURRENCY_SYMBOL|DASH_PUNCTUATION|DECIMAL_NUMBER|ENCLOSING_MARK|FINAL_PUNCTUATION|FORMAT|INITIAL_PUNCTUATION|LETTER_NUMBER|LETTER|LINE_SEPARATOR|LOWERCASE_LETTER|MARK|MATH_SYMBOL|MODIFIER_LETTER|MODIFIER_SYMBOL|NONSPACING_MARK|NUMBER|OPEN_PUNCTUATION|OTHER_LETTER|OTHER_NUMBER|OTHER_PUNCTUATION|OTHER_SYMBOL|OTHER|PARAGRAPH_SEPARATOR|PRIVATE_USE|PUNCTUATION|SEPARATOR|SPACE_SEPARATOR|SPACING_MARK|SURROGATE|SYMBOL|TITLECASE_LETTER|UNASSIGNED|UPPERCASE_LETTER)\b'
  unicode_script_rules: '\b(ADLAM|AHOM|ANATOLIAN_HIEROGLYPHS|ARABIC|ARMENIAN|AVESTAN|BALINESE|BAMUM|BASSA_VAH|BATAK|BENGALI|BHAIKSUKI|BOPOMOFO|BRAHMI|BRAILLE|BUGINESE|BUHID|CANADIAN_ABORIGINAL|CARIAN|CAUCASIAN_ALBANIAN|CHAKMA|CHAM|CHEROKEE|CHORASMIAN|COMMON|COPTIC|CUNEIFORM|CYPRIOT|CYPRO_MINOAN|CYRILLIC|DESERET|DEVANAGARI|DIVES_AKURU|DOGRA|DUPLOYAN|EGYPTIAN_HIEROGLYPHS|ELBASAN|ELYMAIC|ETHIOPIC|GEORGIAN|GLAGOLITIC|GOTHIC|GRANTHA|GREEK|GUJARATI|GUNJALA_GONDI|GURMUKHI|HANIFI_ROHINGYA|HANGUL|HANUNOO|HAN|HATRAN|HEBREW|HIRAGANA|IMPERIAL_ARAMAIC|INHERITED|INSCRIPTIONAL_PAHLAVI|INSCRIPTIONAL_PARTHIAN|JAVANESE|KAITHI|KANNADA|KATAKANA|KAWI|KAYAH_LI|KHAROSHTHI|KHITAN_SMALL_SCRIPT|KHMER|KHOJKI|KHUDAWADI|LAO|LATIN|LEPCHA|LIMBU|LINEAR_A|LINEAR_B|LISU|LYCIAN|LYDIAN|MAHAJANI|MAKASAR|MALAYALAM|MANDAIC|MANICHAEAN|MARCHEN|MASARAM_GONDI|MEDEFAIDRIN|MEETEI_MAYEK|MENDE_KIKAKUI|MEROITIC_CURSIVE|MEROITIC_HIEROGLYPHS|MIAO|MODI|MONGOLIAN|MRO|MULTANI|MYANMAR|NABATAEAN|NAG_MUNDARI|NANDINAGARI|NEW_TAI_LUE|NEWA|NKO|NUSHU|NYIAKENG_PUACHUE_HMONG|OGHAM|OL_CHIKI|OLD_HUNGARIAN|OLD_ITALIC|OLD_NORTH_ARABIAN|OLD_PERMIC|OLD_PERSIAN|OLD_SOGDIAN|OLD_SOUTH_ARABIAN|OLD_TURKIC|OLD_UYGHUR|ORIYA|OSAGE|OSMANYA|PAHAWH_HMONG|PALMYRENE|PAU_CIN_HAU|PHAGS_PA|PHOENICIAN|PSALTER_PAHLAVI|REJANG|RUNIC|SAMARITAN|SAURASHTRA|SHARADA|SHAVIAN|SIDDHAM|SIGNWRITING|SINHALA|SOGDIAN|SORA_SOMPENG|SOYOMBO|SUNDANESE|SYLOTI_NAGRI|SYRIAC|TAGALOG|TAGBANWA|TAI_LE|TAI_THAM|TAI_VIET|TAKRI|TAMIL|TANGSA|TANGUT|TELUGU|THAANA|THAI|TIBETAN|TIFINAGH|TIRHUTA|TOTO|UGARITIC|VAI|VITHKUQI|WANCHO|WARANG_CITI|YEZIDI|YI|ZANABAZAR_SQUARE)\b'
  support_idents: '{{builtin_rules}}|{{ascii_rules}}|{{unicode_binary_rules}}|{{unicode_category_rules}}|{{unicode_script_rules}}|{{replaceable_support_idents}}'
  escaped_char: '\\("|\\|r|n|t|0|''|x\h{2}|u\{\h{2,6}\})'
contexts:
  main:
    - match: (//!).*$\n?
      scope: comment.line.double-dash.pest
      captures:
        1: punctuation.definition.comment.pest
    - match: (?=///)
      set: main_rules
    - include: comments
    - include: rule_decl

  main_rules:
    - match: (///).*$\n?
      scope: comment.line.double-dash.pest
      captures:
        1: punctuation.definition.comment.pest
    - include: comments
    - include: rule_decl

  rule_decl:
    - match: '{{replaceable_support_idents}}'
      scope: support.function.override.pest
      set: [main_rules, rule_def, must_be_equals]
    - match: '{{forbidden_rule_idents}}'
      scope: invalid.pest
      set: [main_rules, rule_def, must_be_equals]
    - match: '{{ident}}'
      scope: entity.name.function.pest
      set: [main_rules, rule_def, must_be_equals]
    - match: \S
      scope: invalid.pest

  must_be_equals:
    - include: comments
    - match: '='
      scope: keyword.operator.pest
      pop: true
    - match: \S
      scope: invalid.pest

  rule_def:
    - include: comments
    - match: '[@_$!]'
      scope: keyword.operator.pest
      set: rule_brace
    - include: rule_brace

  rule_brace:
    - include: comments
    - match: '\{'
      set: [rule_close, rule_start]
    - match: \S
      scope: invalid.pest

  rule_close:
    - match: '\}?'
      pop: true

  paren_close:
    - match: '\)'
      scope: punctuation.section.parens.end.pest
      pop: true
    - match: '\}'
      scope: invalid.pest
      pop: true
    - match: ''
      pop: true

  rule_start:
    - include: comments
    - match: '\|'
      scope: keyword.operator.pest
      set: expr_expect_term
    - include: expr_expect_term

  expr_expect_term:
    - include: comments
    - match: '#[_a-zA-Z]\w*(?=(?:\s|/\*.*?\*/)*=)'
      scope: entity.name.tag.pest
      set: [expr_expect_node, must_be_equals]
    - include: expr_expect_node

  expr_expect_node:
    - include: comments
    - match: '[~|]|#[_a-zA-Z]\w*(?:\s*=)?'
      scope: invalid.pest
    - match: '[})]'
      scope: invalid.pest
      pop: true
    - match: '[!&]'
      scope: keyword.operator.pest
      set: expr_expect_node
    - match: '(?=^\s*{{ident}}\s*=)'
      pop: true
    - match: '\^'
      scope: keyword.operator.pest
      set: [expr_after_term, trailing, insensitive_string]
    - match: '"'
      scope: punctuation.definition.string.begin.pest
      set: [expr_after_term, trailing, double_quoted_string]
    - match: ''''
      scope: punctuation.definition.string.begin.pest
      set: [expr_after_term, char_after, char_literal]
    - match: '\bPEEK\b'
      scope: meta.function-call support.function.pest
      set: [expr_after_term, peek_or_trailing]
    - match: '\bPUSH_LITERAL(?=(?:\s|/\*.*?\*/)*\()'
      scope: meta.function-call support.function.pest
      set: [expr_after_term, trailing, push_literal_arg, open_paren]
    - match: '\bPUSH(?=(?:\s|/\*.*?\*/)*\()'
      scope: meta.function-call support.function.pest
      set: [expr_after_term, trailing, paren_close, expr_expect_term, open_paren]
    - match: '\('
      scope: punctuation.section.parens.begin.pest
      set: [expr_after_term, trailing, paren_close, expr_expect_term]
    - match: '{{support_idents}}'
      scope: meta.function-call support.function.pest
      set: [expr_after_term, trailing]
    - match: '{{ident}}'
      scope: meta.function-call variable.function.pest
      set: [expr_after_term, trailing]
    - match: '[^\s~|}()]+'
      scope: invalid.pest
      set: [expr_after_term, trailing]

  expr_after_term:
    - include: comments
    - match: '(?=^\s*{{ident}}\s*=|[})])'
      pop: true
    - match: '[~|]'
      scope: keyword.operator.pest
      set: expr_expect_term
    - match: '"(?:[^"\\]|\\.)*"|''(?:[^''\\]|\\.)*''|\S'
      scope: invalid.pest

  insensitive_string:
    - include: comments
    - match: '"'
      scope: punctuation.definition.string.begin.pest
      set: double_quoted_string
    - match: '''(?:[^''\\]|\\.)*''|[^\s~|}()]+|\S'
      scope: invalid.pest
      pop: true

  peek_or_trailing:
    - include: comments
    - match: '\['
      set: [trailing, peek_slice]
    - include: trailing

  open_paren:
    - include: comments
    - match: '\('
      scope: punctuation.section.parens.begin.pest
      pop: true

  escaped-char:
    - match: '{{escaped_char}}'
      scope: constant.character.escape.pest
    - match: '\\(?:.|$)'
      scope: invalid.pest

  double_quoted_string:
    - meta_scope: string.quoted.double.pest
    - include: escaped-char
    - match: '"'
      scope: punctuation.definition.string.end.pest
      pop: true

  char_literal:
    - meta_scope: string.quoted.single.pest
    - match: ''''
      scope: punctuation.definition.string.end.pest invalid.pest
      pop: true
    - match: '[^''\r\n]+(?=[^''\r\n]*$)|$'
      scope: invalid.pest
      pop: true
    - match: '{{escaped_char}}'
      scope: constant.character.escape.pest
      set: char_literal_end
    - match: '\\(?:.|$)'
      scope: invalid.pest
      set: char_literal_end
    - match: '[^''\\\r\n]'
      set: char_literal_end

  char_literal_end:
    - meta_scope: string.quoted.single.pest
    - match: ''''
      scope: punctuation.definition.string.end.pest
      pop: true
    - match: '[^''\r\n]+'
      scope: invalid.pest
    - match: '$'
      pop: true

  char_after:
    - include: comments
    - match: '\s*(\.\.)'
      captures:
        1: keyword.operator.range.pest
      set: [trailing, char_range_rhs]
    - include: trailing

  char_range_rhs:
    - include: comments
    - match: ''''
      scope: punctuation.definition.string.begin.pest
      set: char_literal
    - match: \S
      scope: invalid.pest
      pop: true

  push_literal_arg:
    - include: comments
    - match: '"'
      scope: punctuation.definition.string.begin.pest
      set: [push_literal_end, double_quoted_string]
    - match: '[})]'
      scope: invalid.pest
      pop: true
    - match: '[^\s)}]+'
      scope: invalid.pest
      set: push_literal_end

  push_literal_end:
    - include: comments
    - match: '\)'
      scope: punctuation.section.parens.end.pest
      pop: true
    - match: '\}'
      scope: invalid.pest
      pop: true
    - match: \S
      scope: invalid.pest

  comments:
    - match: (//)(?![/!]).*$\n?
      scope: comment.line.double-dash.pest
      captures:
        1: punctuation.definition.comment.pest
    - match: //[/!].*$\n?
      scope: invalid.pest
    - include: block_comment

  block_comment:
    - match: '/\*'
      scope: punctuation.definition.comment.pest
      push:
        - meta_scope: comment.block.pest
        - include: block_comment
        - match: '\*/'
          scope: punctuation.definition.comment.pest
          pop: true

  peek_slice:
    - include: comments
    - match: '(?:-0*[1-9]\d*|\d+)'
      scope: constant.numeric.integer.pest
      set: peek_slice_need_dots
    - include: peek_slice_need_dots

  peek_slice_need_dots:
    - include: comments
    - match: '\.\.'
      scope: keyword.operator.range.pest
      set: peek_slice_after_dots
    - match: '\]'
      scope: invalid.pest
      pop: true
    - match: \S
      scope: invalid.pest
      set: peek_slice_end

  peek_slice_after_dots:
    - include: comments
    - match: '(?:-0*[1-9]\d*|\d+)'
      scope: constant.numeric.integer.pest
      set: peek_slice_end
    - include: peek_slice_end

  peek_slice_end:
    - include: comments
    - match: '\]'
      pop: true
    - match: \S
      scope: invalid.pest

  trailing:
    - include: comments
    - match: '{{trailing_op}}'
      scope: keyword.operator.pest
      set: trailing_after_op
    - include: trailing_common

  trailing_after_op:
    - include: comments
    - match: '{{trailing_op}}'
      scope: invalid.pest
    - include: trailing_common

  trailing_common:
    - match: '\{'
      push: trailing_braces
    - match: '\s+'
    - match: ''
      pop: true

  trailing_braces:
    - include: comments
    - match: ','
      set: brace_need_digit
    - match: \d+
      scope: constant.numeric.integer.pest
      set: brace_after_first_digit
    - include: brace_need_digit

  brace_need_digit:
    - include: comments
    - match: '}'
      scope: invalid.pest
      pop: true
    - match: \d+
      scope: constant.numeric.integer.pest
      set: brace_end
    - match: \S
      scope: invalid.pest

  brace_after_first_digit:
    - include: comments
    - match: ','
      set: brace_after_comma
    - include: brace_end

  brace_after_comma:
    - include: comments
    - match: \d+
      scope: constant.numeric.integer.pest
      set: brace_end
    - include: brace_end

  brace_end:
    - include: comments
    - match: '}'
      pop: true
    - match: \S
      scope: invalid.pest